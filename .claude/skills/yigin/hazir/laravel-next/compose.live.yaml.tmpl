# Canlı sunucu. Yerel ortamın provası değildir.
# Yol: Nginx Proxy Manager (80/443, SSL) → __PROJE__-traefik:80 → servisler.
# Bu dosya hiçbir portu dışarı açmaz. Veritabanı portu yayımlanmaz.
# Proje kendi ağını (__PROJE__-network) açar; NPM bu ağa sunucuda bir kez bağlanır:
#   docker network connect __PROJE__-network <npm-konteyneri>
# Konteyner adı, proje adı ile hizmet adının tire ile birleşmesidir. Örnek: my-project-redis.
# Bu ad her serviste container_name satırıyla açıkça yazılır.

name: __PROJE__-live

x-laravel-env: &laravel-env
  DB_CONNECTION: pgsql
  DB_HOST: db
  DB_PORT: "5432"
  REDIS_HOST: redis
  REDIS_PORT: "6379"
  CACHE_STORE: redis
  SESSION_DRIVER: redis
  # Canlıda site https; oturum çerezi yalnızca https üzerinden gönderilir.
  SESSION_SECURE_COOKIE: "true"
  SANCTUM_STATEFUL_DOMAINS: ${APP_DOMAIN:?APP_DOMAIN .env içinde canlı alan adıyla doldurulmalı}
  # >>> ek:queue
  QUEUE_CONNECTION: redis
  REDIS_QUEUE_RETRY_AFTER: "960"
  # <<< ek:queue
  # >>> ek-yok:queue
  QUEUE_CONNECTION: sync
  # <<< ek-yok:queue

x-backend: &backend
  # PID 1'de sinyalleri iletir; yoksa Horizon ve PHP kapanma sinyalini almaz ve zorla öldürülür.
  init: true
  image: __PROJE__-backend:prod
  build:
    context: .
    dockerfile: docker/php/Dockerfile
    target: prod
  env_file: .env
  environment: *laravel-env
  volumes:
    - backend-storage:/var/www/html/storage/app
  restart: unless-stopped
  depends_on:
    db:
      condition: service_healthy
    redis:
      condition: service_healthy

services:
  # Traefik Docker'a doğrudan değil, yalnızca konteyner listeleme izni veren bu vekil üzerinden erişir.
  socket-proxy:
    container_name: __PROJE__-socket-proxy
    image: tecnativa/docker-socket-proxy:3.4
    environment:
      CONTAINERS: 1
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    restart: unless-stopped
    networks:
      - socket

  traefik:
    container_name: __PROJE__-traefik
    image: traefik:v3.6
    command:
      - --providers.docker=true
      - --providers.docker.endpoint=tcp://socket-proxy:2375
      - --providers.docker.exposedbydefault=false
      - --providers.docker.network=__PROJE__-network
      - --entrypoints.web.address=:80
      # NPM'nin gönderdiği X-Forwarded-Proto/Host korunur. Traefik'e yalnızca Docker ağından erişilir.
      - --entrypoints.web.forwardedheaders.insecure=true
      - --log.level=WARN
    restart: unless-stopped
    depends_on:
      - socket-proxy
    networks:
      - default
      - socket

  nginx:
    container_name: __PROJE__-nginx
    build:
      context: .
      dockerfile: docker/nginx/Dockerfile
    restart: unless-stopped
    depends_on:
      - backend
    # API_DOMAIN boşsa kural .invalid alan adına düşer ve hiçbir istekle eşleşmez.
    labels:
      - traefik.enable=true
      - traefik.http.routers.__PROJE__-api.rule=Host(`${API_DOMAIN:-api.invalid}`)
      - traefik.http.routers.__PROJE__-api.entrypoints=web
      - traefik.http.services.__PROJE__-api.loadbalancer.server.port=80

  backend:
    <<: *backend
    container_name: __PROJE__-backend

  # >>> ek:queue
  # Kuyruklar ve zaman aşımları backend/config/horizon.php içindedir (HAZIR.md → Kuyruklar).
  horizon:
    <<: *backend
    container_name: __PROJE__-horizon
    command: ["php", "artisan", "horizon"]
    stop_grace_period: 16m
  # <<< ek:queue

  # >>> ek:scheduler
  scheduler:
    <<: *backend
    container_name: __PROJE__-scheduler
    command: ["php", "artisan", "schedule:work"]
  # <<< ek:scheduler

  frontend:
    container_name: __PROJE__-frontend
    init: true
    build:
      context: .
      dockerfile: docker/frontend/Dockerfile
      target: prod
    env_file: .env
    environment:
      INTERNAL_API_URL: http://nginx
    restart: unless-stopped
    depends_on:
      - nginx
    labels:
      - traefik.enable=true
      - traefik.http.routers.__PROJE__-app.rule=Host(`${APP_DOMAIN:?APP_DOMAIN .env içinde canlı alan adıyla doldurulmalı}`)
      - traefik.http.routers.__PROJE__-app.entrypoints=web
      - traefik.http.services.__PROJE__-app.loadbalancer.server.port=3000

  db:
    container_name: __PROJE__-db
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: ${DB_DATABASE}
      POSTGRES_USER: ${DB_USERNAME}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    volumes:
      - db-data:/var/lib/postgresql/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]
      interval: 5s
      timeout: 5s
      retries: 10

  redis:
    container_name: __PROJE__-redis
    image: redis:8-alpine
    volumes:
      - redis-data:/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10

networks:
  default:
    name: __PROJE__-network
  # Yalnızca traefik ve socket-proxy bu ağdadır; dışarıya ve NPM'e kapalıdır.
  socket:
    internal: true

volumes:
  db-data:
  redis-data:
  backend-storage:
