    <!--
      backend/phpunit.xml içindeki <php>...</php> bloğunun yerine konur.
      Konteynerde DB_DATABASE, CACHE_STORE gibi değerler zaten tanımlıdır. Laravel ortam değişkenini önce
      $_SERVER'dan okur. Bu yüzden her değer <server ... force="true"/> ile verilir; <env force="true"/>
      yalnızca $_ENV'i ezer ve yetmez. (2026-11-23 tarihinde denendi: Laravel'in varsayılan phpunit.xml'i
      ile test geliştirme veritabanına kullanıcı yazdı; yalnızca <env force> ile de geliştirme
      veritabanına bağlandı; <server force> ile "testing"e bağlandı.)
      Test veritabanı "testing" adıyla aynı Postgres'te durur; compose.local.yaml içindeki
      db-test-hazirla servisi açar. Koruma: tests/TestCase.php.
    -->
    <php>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <server name="DB_DATABASE" value="testing" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
